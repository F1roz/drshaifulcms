---
layout: base.njk
title: "Chambers & Locations"
description: "Dr. Shaiful Islam's chamber locations, timings, and contact details."
permalink: "chambers.html"
---
<section class="proc-hero">
  <div class="container">
    <div class="eyebrow">Locations</div>
    <h1 class="reveal in">Chambers</h1>
  </div>
</section>
<section>
  <div class="container">
    <div class="chamber-grid">
      {% for c in chambers.chambers %}
      <div class="chamber-card reveal">
        <span class="chamber-tag">{{ c.tag }}</span>
        <h3>{{ c.name }}</h3>
        <div class="chamber-row"><b>Address</b><span>{{ c.address }}</span></div>
        <div class="chamber-row"><b>Days</b><span>{{ c.days }}</span></div>
        <div class="chamber-row"><b>Hours</b><span>{{ c.hours }}</span></div>
        <div class="chamber-row"><b>Phone</b><span>{{ c.phone }}</span></div>
        <a href="/appointment.html" class="btn btn-navy" style="margin-top:14px;">Book at this Chamber</a>
      </div>
      {% endfor %}
    </div>
  </div>
</section>
