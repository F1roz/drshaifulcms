---
layout: base.njk
title: "Contact"
description: "Contact Dr. Shaiful Islam's chambers for appointments and enquiries."
permalink: "contact.html"
---
<section class="proc-hero">
  <div class="container">
    <div class="eyebrow">Contact</div>
    <h1 class="reveal in">Get in Touch</h1>
  </div>
</section>
<section>
  <div class="container contact-grid">
    <div class="contact-info-card reveal">
      <div class="contact-line"><div class="contact-icon">&#9742;</div><div><b>Phone</b><p style="color:var(--muted);">{{ contact.phone }}</p></div></div>
      <div class="contact-line"><div class="contact-icon">&#9993;</div><div><b>Email</b><p style="color:var(--muted);">{{ contact.email }}</p></div></div>
      <div class="contact-line"><div class="contact-icon">&#127968;</div><div><b>Main Chamber</b><p style="color:var(--muted);">{{ contact.address }}</p></div></div>
      <div class="contact-line"><div class="contact-icon">&#128337;</div><div><b>Hours</b><p style="color:var(--muted);">{{ contact.hours }}</p></div></div>
      <a href="/chambers.html" class="btn btn-navy" style="margin-top:10px;">View All Chambers</a>
      <form id="contact-form" style="margin-top:34px;border-top:1px solid var(--border);padding-top:30px;">
        <div class="form-group"><label>Name</label><input type="text" required></div>
        <div class="form-group"><label>Email</label><input type="email" required></div>
        <div class="form-group"><label>Message</label><textarea rows="4"></textarea></div>
        <button type="submit" class="btn btn-gold">Send Message</button>
      </form>
      <div class="contact-success form-success"><div class="check">&#10003;</div><h3>Message Sent</h3></div>
    </div>
    <div class="map-frame reveal reveal-delay-1">
      <iframe src="{{ contact.map_embed_url }}" loading="lazy"></iframe>
    </div>
  </div>
</section>
