<section class="proc-hero">
  <div class="container">
    <div class="eyebrow">Gallery</div>
    <h1 class="reveal in">Photo Gallery</h1>
  </div>
</section>
<section>
  <div class="container">
    <div class="gallery-grid">
      {% for g in gallery.gallery %}
      <div class="g-item reveal"><img src="{{ g.image }}" alt="{{ g.caption }}"></div>
      {% endfor %}
    </div>
  </div>
</section>
