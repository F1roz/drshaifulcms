---
layout: base.njk
title: "Patient Testimonials"
description: "Read what patients and families say about their experience with Dr. Shaiful Islam."
permalink: "testimonials.html"
---
<section class="proc-hero">
  <div class="container">
    <div class="eyebrow">Testimonials</div>
    <h1 class="reveal in">What Families Say</h1>
  </div>
</section>
<section>
  <div class="container">
    <div class="testi-track" style="grid-template-columns:repeat(3,1fr);">
      {% for t in testimonials.testimonials %}
      <div class="testi-card reveal">
        <div class="stars">{% for i in range(t.rating) %}&#9733;{% endfor %}</div>
        <p class="quote">{{ t.quote }}</p>
        <div class="testi-who"><div class="testi-avatar">{{ t.name | first }}</div><div><div class="name">{{ t.name }}</div><div class="rel">{{ t.relation }}</div></div></div>
      </div>
      {% endfor %}
    </div>
  </div>
</section>
