---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allProcedures = (await getCollection('procedures')).sort((a, b) => (a.data.order ?? 999) - (b.data.order ?? 999));

const categoryAnchors: Record<string, string> = {
  'General Paediatric Surgery': 'general',
  'Neonatal Surgery': 'neonatal',
  'Minimal Access Surgery': 'mas',
  'Paediatric Urology': 'urology',
  'Paediatric Hepatobiliary Surgery': 'hepatobiliary',
  'Paediatric Surgical Oncology': 'oncology',
};

const categoryBlurbs: Record<string, string> = {
  'General Paediatric Surgery': 'Everyday paediatric surgical conditions seen in clinic — from hernias to minor skin and soft-tissue lumps.',
  'Neonatal Surgery': 'Specialist surgical care for structural conditions identified in newborn babies.',
  'Minimal Access Surgery': 'Keyhole surgical techniques used across a wide range of paediatric conditions.',
  'Paediatric Urology': 'Surgical care for the kidneys, bladder, and genitalia in infants and children.',
  'Paediatric Hepatobiliary Surgery': 'Surgical management of liver, bile duct, and gallbladder conditions in children.',
  'Paediatric Surgical Oncology': 'Multidisciplinary surgical care for solid tumours of childhood.',
};

const grouped = new Map<string, typeof allProcedures>();
for (const proc of allProcedures) {
  const cat = proc.data.category;
  if (!grouped.has(cat)) grouped.set(cat, []);
  grouped.get(cat)!.push(proc);
}
---
<Layout title="Procedures &amp; Specialties" description="A comprehensive overview of the paediatric surgical conditions and procedures Dr. Shaiful Islam treats, from routine general surgery to complex neonatal and oncological cases.">
<section class="proc-hero">
  <div class="container">
    <div class="eyebrow">Clinical Expertise</div>
    <h1 class="reveal in">Procedures &amp; Specialties</h1>
    <p class="hero-role" style="max-width:700px;">A comprehensive overview of the paediatric surgical conditions and procedures Dr. Shaiful Islam treats, from routine general surgery to complex neonatal and oncological cases.</p>
  </div>
</section>
<section>
  <div class="container">
    {Array.from(grouped.entries()).map(([category, procs]) => (
      <div class="cat-block" id={categoryAnchors[category] ?? category.toLowerCase().replace(/\s+/g, '-')}>
        <div class="cat-head"><h2>{category}</h2><span>{categoryBlurbs[category] ?? ''}</span></div>
        <div class="proc-grid">
          {procs.map((proc) => (
            <a href={`/procedures/${proc.id}`} class="proc-tile reveal">
              <h4>{proc.data.title}</h4>
              <p>{proc.data.description}</p>
              <span class="go">Read more &rarr;</span>
            </a>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>
</Layout>
