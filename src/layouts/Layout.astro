---
import { getEntry } from 'astro:content';


export interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const { title, description, ogImage } = Astro.props;
const settings = await getEntry('settings', 'global');
const s = settings!.data;
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{title} | {s.brandName} — {s.brandRole}</title>
{description && <meta name="description" content={description} />}
<meta property="og:title" content={`${title} | ${s.brandName}`} />
{description && <meta property="og:description" content={description} />}
<meta property="og:type" content="website" />
{ogImage && <meta property="og:image" content={ogImage} />}
<link rel="icon" type="image/png" href="/assets/img/kmsi.jpg">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="/assets/css/style.css">
</head>
<body>
<div id="loader"><div class="loader-mark">{s.brandName}</div><div class="loader-bar"><span></span></div></div>

<header class="nav">
  <div class="container nav-inner">
    <a href="/" class="brand">
      <span class="brand-name">{s.brandName}</span>
      <span class="brand-role">{s.brandRole}</span>
    </a>
    <nav class="nav-links">
      <a href="/">Home</a>
      <a href="/about">About</a>
      <a href="/procedures">Expertise</a>
      <a href="/qualifications">Qualifications</a>
      <a href="/career">Career</a>
      <a href="/research">Research</a>
      <a href="/memberships">Memberships</a>
      <a href="/gallery">Gallery</a>
      <a href="/videos">Videos</a>
      <a href="/chambers">Chambers</a>
      <a href="/contact">Contact</a>
    </nav>
    <button class="hamburger" aria-label="Menu"><span></span><span></span><span></span></button>
  </div>
</header>

<slot />

<footer>
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <span class="brand-name" style="font-family:var(--font-display);font-size:1.4rem;">{s.brandName}</span>
        <p>{s.footerTagline}</p>
        <div class="footer-social">
          {s.social.facebook && <a href={s.social.facebook} aria-label="Facebook">f</a>}
          {s.social.linkedin && <a href={s.social.linkedin} aria-label="LinkedIn">in</a>}
          {s.social.youtube && <a href={s.social.youtube} aria-label="YouTube">yt</a>}
        </div>
      </div>
      <div class="footer-col">
        <h5>Quick Links</h5>
        <a href="/about">About Dr. Islam</a>
        <a href="/qualifications">Qualifications</a>
        <a href="/career">Career History</a>
        <a href="/research">Research</a>
        <a href="/memberships">Memberships</a>
      </div>
      <div class="footer-col">
        <h5>Specialties</h5>
        <a href="/procedures#neonatal">Neonatal Surgery</a>
        <a href="/procedures#mas">Minimal Access Surgery</a>
        <a href="/procedures#urology">Paediatric Urology</a>
        <a href="/procedures#hepatobiliary">Hepatobiliary Surgery</a>
        <a href="/procedures#oncology">Paediatric Oncology</a>
      </div>
      <div class="footer-col">
        <h5>Chambers</h5>
        <a href="/chambers">Dhaka — BMU Shahbag</a>
        <a href="/chambers">Khulna Chamber</a>
        <a href="/chambers">Evening Chamber, Dhanmondi</a>
        <a href="/contact">Get Directions</a>
      </div>
    </div>
    <div class="footer-bottom">
      <span>{s.copyright}</span>
      <span>{s.disclaimer}</span>
    </div>
  </div>
</footer>
<a href="#" class="back-top" aria-label="Back to top">&uarr;</a>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
<script src="/assets/js/main.js" is:inline></script>
</body>
</html>
